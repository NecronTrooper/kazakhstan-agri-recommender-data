# Байткод Python
__pycache__/
*.pyc

# Кэш сырых файлов источников — легко пересобирается скриптами,
# не нужен в репозитории (в сумме >50 МБ, в основном NetCDF от ERA5)
output/era5_cache/
output/stat_gov_kz_cache/
output/grainunion_cache/

# Ручная выгрузка stat.gov.kz (при наличии) — не публикуем сырые
# выгрузки со стороннего сайта без явного решения
input/*.xlsx
input/*.csv

# Локальные архивы для загрузки в портал журнала и т.п. — дубликат
# уже отслеженных файлов, раздувает репозиторий без пользы
figures.zip
*.zip
.coverage
coverage.xml
test-results.xml
.ruff_cache/
p16.log

# Черновики статей и рукописи — не публикуем (ранее добавленные дескрипторы MDPI/DataInBrief отслеживаются явно)
data_descriptor_*.pdf
!data_descriptor_*.md
data_descriptor_AstanaIT.md
data_descriptor_Eurasian*.md
data_descriptor_KSTU*.md
data_descriptor_Vestnik*.md
ieee_sist_paper*
